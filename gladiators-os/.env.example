# ── Supabase ──────────────────────────────────────────────────────────
# Estas dos sí cruzan al navegador. La clave publicable es de solo lectura
# bajo RLS: no da acceso a nada que las políticas no permitan.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta NUNCA cruza al navegador ni se escribe en el repositorio. Se salta
# RLS por completo. Solo la usan las semillas y las pruebas de permisos.
SUPABASE_SERVICE_ROLE_KEY=

# ── DocuSign ──────────────────────────────────────────────────────────
# Pendiente de la sección 13 del documento: hace falta la integration key
# de la cuenta de desarrollador y el go-live. Hasta entonces la pestaña
# corre en modo demostración y no llama a ninguna API.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URI=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_REFRESH_TOKEN=
